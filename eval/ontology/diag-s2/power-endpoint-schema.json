{
  "_comment": "Closed schema for runs/onto-c-power/power-hc1-endpoint.json (P-HC1b). Interpreted by validatePower (Object.hasOwn, every own field traversed). Aggregate-only: no run ids, task text or argument values.",
  "endpoint": "one-sided paired task-crossed bootstrap: precision(V3-V2) > precision_margin and recall(V3-recall_ref) > -recall_margin",
  "enums": { "recall_ref": ["V2", "boundV1"] },
  "crosstabPattern": "^$",
  "defs": {
    "observed": { "k": "obj", "keys": {
      "precision_v2": { "k": "num" }, "precision_v3": { "k": "num" }, "precision_diff": { "k": "num" },
      "recall_v3": { "k": "num" }, "recall_ref": { "k": "nullnum" }, "recall_diff": { "k": "nullnum" },
      "positives": { "k": "int" }, "runs": { "k": "int" } } },
    "fit": { "k": "obj", "keys": { "a": { "k": "num" }, "r2": { "k": "num" } } },
    "design": { "k": "obj", "keys": {
      "K": { "k": "int" }, "U": { "k": "int" }, "J": { "k": "int" }, "repeats_tasks": { "k": "bool" },
      "expected_runs": { "k": "num" }, "expected_positives": { "k": "num" },
      "mean_precision_diff": { "k": "nullnum" }, "mean_recall_diff": { "k": "nullnum" }, "outer_sd": { "k": "nullnum" },
      "power_joint": { "k": "num" }, "power_precision_only": { "k": "num" }, "power_recall_guard_only": { "k": "num" },
      "power_joint_mc_se": { "k": "num" }, "power_precision_mc_se": { "k": "num" }, "power_recall_guard_mc_se": { "k": "num" },
      "n_valid": { "k": "int" }, "n_inconclusive": { "k": "int" }, "n_undefined": { "k": "int" } } },
    "pool": { "k": "obj", "keys": {
      "observed": { "$ref": "observed" }, "fit": { "$ref": "fit" },
      "designs": { "k": "arr", "items": { "$ref": "design" } } } }
  },
  "root": { "k": "obj", "keys": {
    "endpoint": { "k": "str", "const": "endpoint" },
    "alpha": { "k": "num" }, "recall_margin": { "k": "num" }, "precision_margin": { "k": "num" },
    "recall_ref": { "k": "str", "in": "recall_ref" },
    "sim": { "k": "obj", "keys": { "N": { "k": "int" }, "R": { "k": "int" }, "seed": { "k": "int" } } },
    "grid": { "k": "obj", "keys": { "K": { "k": "arr", "items": { "k": "int" } }, "U": { "k": "arr", "items": { "k": "int" } }, "J": { "k": "arr", "items": { "k": "int" } } } },
    "pools": { "k": "obj", "keys": { "S2": { "$ref": "pool" }, "S1": { "$ref": "pool", "opt": true } } }
  } }
}
